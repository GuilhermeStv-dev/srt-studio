{
  "name": "@srt-studio/desktop",
  "productName": "SRTX",
  "version": "0.2.2",
  "private": true,
  "author": "Guilherme Estevão",
  "description": "SRTX — editor local para transcrição e geração de SRT Premiere-safe.",
  "main": "./out/main/index.js",
  "scripts": {
    "electron:install": "install-electron --no",
    "build:icon": "node ../../scripts/build-brand-icon.mjs",
    "predev": "npm run build:icon && npm run electron:install",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^43.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-vite": "5.0.0",
    "typescript": "latest",
    "vite": "7.3.6"
  }
}
